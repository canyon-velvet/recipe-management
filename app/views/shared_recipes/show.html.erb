<%# A recipe shared by its link, for anyone: the recipe alone, without its owner's actions, kept out of search
    engines, with a title and description for the preview a chat app shows of the link %>
<% content_for :title, @recipe.name %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= @recipe.name %>">
  <meta property="og:description" content="<%= recipe_summary(@recipe).truncate(200) %>">
  <meta property="og:url" content="<%= shared_recipe_url(@recipe.share_token) %>">
  <meta property="og:image" content="<%= "#{request.base_url}/icon-512.png" %>">
  <meta property="og:site_name" content="<%= t("app_name") %>">
<% end %>
<%= render "recipes/recipe_page", recipe: @recipe, actions: false %>
