<section class="container mx-auto max-w-2xl px-4 py-8">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <p class="text-sm text-gray-500 mt-1 mb-6"><%= t(".hint") %></p>

  <% if @result && !@result.success? %>
    <div class="bg-red-50 border border-red-300 text-red-700 rounded-md p-3 mb-4 text-sm">
      <%= t("imports.errors.#{@result.error}") %>
      <% if @result.recipe %>
        <%= link_to t(".view_recipe"), recipe_path(@result.recipe), class: "underline font-medium" %>
      <% elsif @result.error == :already_in_draft_box %>
        <%= link_to t(".open_draft_box"), drafts_path, class: "underline font-medium" %>
      <% end %>
    </div>
  <% end %>

  <%= form_with url: imports_path, class: "space-y-4" do |f| %>
    <div class="field">
      <%= f.label :url, t(".link"), class: "form-label" %>
      <%= f.url_field :url, value: @url, placeholder: "https://...", class: "form-input", autofocus: !@paste %>
    </div>

    <%= tag.details class: "import-paste", open: @paste do %>
      <summary class="import-paste-toggle"><%= t(".paste_instead") %></summary>
      <% if @can_paste %>
        <p class="help-text mb-2"><%= t(".paste_hint") %></p>
        <%= f.text_area :text, value: @text, rows: 12, class: "form-textarea", autofocus: @paste,
                        maxlength: Draft::MAX_SOURCE_TEXT, placeholder: t(".paste_placeholder") %>
      <% else %>
        <p class="help-text"><%= t(".paste_needs_claude") %></p>
      <% end %>
    <% end %>

    <div class="flex items-center gap-3 pt-2">
      <%= f.submit t(".submit"), class: "btn-primary" %>
      <%= link_to t("actions.cancel"), recipes_path, class: "btn-cancel" %>
    </div>
  <% end %>
</section>
