<%# Shown in the recipe list's pop-up (shared/modal_frame), and as a page of its own from other links (the home page,
    a draft's "paste instead") and for a problem %>
<section class="modal-page modal-panel modal-panel--roomy">
  <%= turbo_frame_tag "new_import" do %>
    <h2 id="new_import_title" class="modal-heading"><%= t(".heading") %></h2>
    <p class="modal-lead"><%= t(".hint") %></p>

    <% if @result && !@result.success? %>
      <div class="bg-red-50 border border-red-300 text-red-700 rounded-md p-3 mb-4 text-sm">
        <%= t("imports.errors.#{@result.error}", max: Draft::MAX_SCREENSHOTS) %>
        <% if @result.recipe %>
          <%= link_to t(".view_recipe"), recipe_path(@result.recipe), class: "underline font-medium",
                      data: { turbo_frame: "_top" } %>
        <% elsif @result.error == :already_in_draft_box %>
          <%= link_to t(".open_draft_box"), drafts_path, class: "underline font-medium",
                      data: { turbo_frame: "_top" } %>
        <% end %>
      </div>
    <% end %>

    <%# Link, Screenshot or Text, one at a time. Each one's fields are a panel (a fieldset) shown, sent and checked only
        while it's chosen (import-form controller): Link's link box; Screenshot's name, source and pictures, shrunk on
        the phone before they're sent (screenshots controller); Text's source and paste box. A blocked link's "Paste
        text instead" opens Text with that link kept, so the same draft is read again, and its site as the source. %>
    <%= form_with url: imports_path, class: "import-form space-y-4",
                  data: { turbo_frame: "_top", controller: "import-form screenshots",
                          screenshots_max_value: Draft::MAX_SCREENSHOTS,
                          screenshots_remove_label_value: t(".remove_screenshot") } do |f| %>
      <fieldset class="import-modes" data-action="change->import-form#modeChanged">
        <legend class="sr-only"><%= t(".mode") %></legend>
        <% ImportsController::MODES.each do |mode| %>
          <label class="import-mode">
            <%= f.radio_button :mode, mode, checked: @mode == mode, class: "sr-only",
                               data: { import_form_target: "mode" } %>
            <%= inline_icon mode %> <%= t(".modes.#{mode}") %>
          </label>
        <% end %>
      </fieldset>

      <%= import_panel "link", @mode do %>
        <div class="field">
          <%= f.label :url, t(".link"), class: "form-label" %>
          <%= f.url_field :url, value: @url, placeholder: "https://...", class: "form-input",
                            autofocus: @mode == "link" %>
        </div>
      <% end %>

      <% if @has_claude %>
        <%= import_panel "screenshot", @mode do %>
          <div class="field">
            <%= f.label :title, t(".title"), class: "form-label" %>
            <%= f.text_field :title, value: @title, placeholder: t(".title_placeholder"), class: "form-input",
                             required: true, autofocus: @mode == "screenshot" %>
          </div>
        <% end %>

        <%= import_panel "text screenshot", @mode do %>
          <%= render "shared/source_picker", field: "source_id", selected: @source, new_name: @new_source_name,
                                             new_name_field: "new_source_name" %>
        <% end %>

        <%= import_panel "screenshot", @mode do %>
          <div class="import-shots-picker" data-screenshots-target="picker">
            <%= f.file_field :screenshots, multiple: true, accept: "image/*", class: "sr-only",
                             data: { screenshots_target: "input", action: "screenshots#add" } %>
            <label for="screenshots" class="import-shots-drop">
              <span class="import-shots-drop-icons"><%= inline_icon "screenshot" %><%= inline_icon "camera" %></span>
              <span class="import-shots-drop-title"><%= t(".choose_screenshots") %></span>
              <span class="import-shots-drop-hint"><%= t(".screenshots_hint", count: Draft::MAX_SCREENSHOTS) %></span>
            </label>
            <div class="import-shots-grid">
              <ul class="import-shots-list" data-screenshots-target="list"></ul>
              <label for="screenshots" class="import-shots-add" data-screenshots-target="add">
                <span aria-hidden="true">＋</span> <%= t(".add_screenshots") %>
              </label>
            </div>
            <p class="import-shots-note help-text"><%= t(".screenshots_note") %></p>
          </div>
        <% end %>

        <%= import_panel "text", @mode do %>
          <%# The blocked link whose text this is, kept so its draft is read again %>
          <%= hidden_field_tag :url, @url, id: nil if @mode == "text" && @url.present? %>
          <div class="field">
            <%= f.label :text, t(".text"), class: "form-label" %>
            <%= f.text_area :text, value: @text, rows: 8, class: "form-textarea", autofocus: @mode == "text",
                            maxlength: Draft::MAX_SOURCE_TEXT, placeholder: t(".paste_placeholder") %>
            <p class="help-text"><%= t(".paste_hint") %></p>
          </div>
        <% end %>
      <% else %>
        <%= import_panel "text screenshot", @mode do %>
          <p class="help-text"><%= t(".needs_claude") %></p>
        <% end %>
      <% end %>

      <div class="flex flex-wrap items-center justify-between gap-2 pt-2">
        <%# What's waiting in the Draft box, and how many more imports this hour (in amber once few are left) %>
        <div class="import-notes">
          <% if (waiting = draft_counts.values.sum).positive? %>
            <%= link_to t(".draft_box_count", count: waiting), drafts_path, class: "import-draft-count",
                  data: { turbo_frame: "_top" } %>
          <% end %>
          <%= tag.p t(".imports_left", count: imports_left, total: StartImportService.hourly_limit(current_user)),
                    class: [ "import-limit", ("import-limit--low" if imports_left <= StartImportService::FEW_LEFT) ] %>
        </div>
        <div class="ml-auto flex gap-2">
          <%= link_to t("actions.cancel"), recipes_path, class: "btn-pill-ghost btn-pill-sm",
                data: { turbo_frame: "_top", action: "modal#close:prevent" } %>
          <%= f.submit t(".submit"), class: "btn-pill-primary btn-pill-sm cursor-pointer disabled:opacity-60",
                       data: { screenshots_target: "submit" } %>
        </div>
      </div>
    <% end %>
  <% end %>
</section>
