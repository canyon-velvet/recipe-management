<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-center mb-8"><%= t(".title") %></h1>

  <%= form_with url: login_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :username, User.human_attribute_name(:username), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :username, class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sectiontext-light", autofocus: true %>
    </div>

    <div>
      <%= f.label :password, User.human_attribute_name(:password), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sectiontext-light" %>
    </div>

    <%= f.submit t(".submit"), class: "w-full bg-sectiontext-light text-white py-2 px-4 rounded-md hover:bg-sectiontext cursor-pointer" %>
  <% end %>
</div>
