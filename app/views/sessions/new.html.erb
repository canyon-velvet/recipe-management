<%# Laid out like the home page's hero (home.css), with the form in place of the intro (on its cream sheet, below
    the photo, on a phone), and the same photo, which the home page then shows from the browser's cache %>
<section class="home-hero full-bleed">
  <div class="home-hero-inner">
    <div class="home-intro">
      <p class="home-eyebrow"><%= t(".eyebrow") %></p>
      <h1 class="home-title"><%= t(".title") %></h1>
      <p class="home-lead"><%= t(".lead") %></p>

      <%= form_with url: login_path, class: "login-form" do |f| %>
        <div class="field">
          <%= f.label :username, User.human_attribute_name(:username), class: "form-label" %>
          <%= f.text_field :username, class: "login-input", autofocus: true, autocomplete: "username" %>
        </div>

        <div class="field">
          <%= f.label :password, User.human_attribute_name(:password), class: "form-label" %>
          <%= f.password_field :password, class: "login-input", autocomplete: "current-password" %>
        </div>

        <%= f.submit t(".submit"), class: "btn-pill-primary login-submit" %>
      <% end %>

      <p class="login-note"><%= t(".invite_only") %></p>
    </div>

    <%# The 1-minute tour: a pill on the photo opens it in a pop-up. It's only downloaded once asked for. %>
    <div class="home-photo" data-controller="modal video">
      <%= image_tag "egg.jpg", alt: "", class: "home-photo-image", fetchpriority: "high" %>
      <button type="button" class="login-tour" aria-haspopup="dialog" data-action="modal#open video#play">
        <span class="login-tour-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-3.5"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
        </span>
        <%= t(".tour") %>
        <span class="login-tour-length"><%= t(".tour_length") %></span>
      </button>

      <dialog data-modal-target="dialog" class="tour-dialog" aria-label="<%= t(".tour_title") %>"
              data-action="click->modal#backdropClose close->modal#closed close->video#pause
                           turbo:before-cache@document->modal#close">
        <div class="tour-dialog-bar">
          <span><%= t(".tour_title") %></span>
          <button type="button" class="tour-close" data-action="modal#close"
                  aria-label="<%= t("actions.close") %>">×</button>
        </div>
        <%= video_tag "tour.mp4", controls: true, preload: "none", playsinline: true, class: "tour-video",
                                  data: { video_target: "video" } %>
      </dialog>
    </div>
  </div>
</section>
