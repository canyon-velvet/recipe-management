<section class="grocery-page" data-controller="grocery-list" data-reload-on-aisle-change>
  <%# Back to the week, the week's dates over the title, and Edit aisles %>
  <div class="meal-plan-header">
    <div>
      <%= link_to meal_plan_path(@meal_plan), class: "meal-plan-back" do %>
        <span aria-hidden="true">←</span> <%= @meal_plan.display_name %>
      <% end %>
      <p class="home-eyebrow mt-4">
        <%= l(@meal_plan.start_date, format: :month_day) %> – <%= l(@meal_plan.end_date, format: :month_day_year) %>
      </p>
      <h1 class="meal-plan-title"><%= t(".title") %></h1>
    </div>
    <button type="button" class="btn-pill-secondary btn-pill-sm cursor-pointer" data-action="aisle-editor#open">
      <%= t("aisle_editor.title") %>
    </button>
  </div>

  <div id="grocery_list">
    <%= render "grocery_lists/list", grocery_list: @grocery_list %>
  </div>
</section>
