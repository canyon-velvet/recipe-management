<%# locals: (aisle:, items:) %>
<section class="grocery-card grocery-aisle-card">
  <h2 class="grocery-card-header">
    <span class="grocery-aisle-name"><%= aisle.name %></span>
    <span class="grocery-aisle-count"><%= items.size %></span>
  </h2>
  <ul class="grocery-items">
    <% items.each do |item| %>
      <%= render "grocery_lists/grocery_item", item: item %>
    <% end %>
  </ul>
</section>
