<%# locals: (recipe:, aisles:, tags:, draft: nil) %>
<%# The recipe's content (name, description, ingredients, method) in cards on the left; Save and the details (tags,
    servings and times, source, link) in a sidebar on the right that stays in view. On a narrow screen the sidebar
    comes after the content. %>
<%= form_with model: recipe, class: "recipe-form" do |f| %>
  <%= hidden_field_tag :draft_id, draft.id if draft %>

  <div class="recipe-form-main">
    <%= render "recipes/form_errors", recipe: recipe %>

    <section class="recipe-form-card">
      <div class="field">
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, class: "form-input", autofocus: true %>
      </div>
      <%= render "shared/markdown_editor", form: f, field: :description, label: Recipe.human_attribute_name(:description),
            rows: 6, min_height: "156px" %>
    </section>

    <section class="recipe-form-card">
      <h2 class="recipe-form-card-title"><%= t(".ingredients") %></h2>
      <%= render "recipes/ingredient_list_fields", form: f, recipe: recipe, aisles: aisles %>
    </section>

    <section class="recipe-form-card">
      <h2 class="recipe-form-card-title"><%= t(".method") %></h2>
      <%= render "recipes/step_list_fields", form: f, recipe: recipe %>
    </section>
  </div>

  <aside class="recipe-form-details">
    <%= render "recipes/form_actions", form: f, recipe: recipe, draft: draft %>
    <h2 class="recipe-form-details-heading"><%= t(".details") %></h2>
    <%= render "recipes/tag_picker", form: f, tags: tags %>
    <%= render "recipes/count_fields", form: f %>
    <%= render "recipes/source_field", form: f, recipe: recipe %>
    <div class="field">
      <%= f.label :source_url, class: "form-label" %>
      <%= f.url_field :source_url, class: "form-input", placeholder: "https://..." %>
    </div>
  </aside>
<% end %>
