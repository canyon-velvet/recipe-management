<%# The catalog (search and tags) beside the cards; on a phone it folds behind "Search & filter" above them.
    Searching reloads only the frame (the heading and the cards), so the search box keeps its focus as you type, and
    the open catalog stays open. It replaces the URL rather than adding to the history, so Back leaves the page.
    Links in the frame leave the page as usual (_top), and a response without the frame (the login page, once the
    session has ended) is shown whole. %>
<%# Searching doesn't tell Turbo the URL changed, so a cached copy could be of a search: no previews from it (Back
    still restores it) %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>
<div class="recipes-page" data-controller="dropdown search-form">
  <%= turbo_frame_tag "recipe_results", target: "_top", class: "contents",
                      data: { action: "turbo:frame-missing->search-form#showWholePage" } do %>
  <div class="recipes-header">
    <div>
      <h1 class="recipes-title">
        <% if @selected_tag %>
          <span aria-hidden="true"><%= @selected_tag.icon %></span> <%= @selected_tag.name %>
        <% else %>
          <%= t(".title") %>
        <% end %>
      </h1>
      <p class="recipes-count">
        <%= t(".count", count: @pagy.count) %><%= " · #{t('.matching', query: params[:q])}" if params[:q].present? %>
      </p>
    </div>
    <div class="recipes-actions">
      <%= link_to t(".import_recipe"), new_import_path, class: "btn-pill-secondary btn-pill-sm" %>
      <%= link_to "＋ #{t('.new_recipe')}", new_recipe_path, class: "btn-pill-primary btn-pill-sm" %>
    </div>
  </div>

  <section class="recipes-results">
    <% if @recipes.any? %>
      <div class="recipes-grid">
        <% @recipes.each do |recipe| %>
          <%= render "recipes/recipe_card", recipe: recipe %>
        <% end %>
      </div>
    <% else %>
      <p class="recipes-empty"><%= t(".empty") %></p>
    <% end %>

    <%= render "shared/pagination", pagy: @pagy %>
  </section>
  <% end %>

  <%# Outside the frame, so searching doesn't redraw it and lose whether the catalog is open %>
  <button type="button" class="recipes-filter-toggle" data-action="dropdown#toggle" data-dropdown-target="button"
          aria-controls="recipes-filters" aria-expanded="false">
    <span aria-hidden="true">🔍</span> <%= t(".search_and_filter") %><%= " · #{@selected_tag.name}" if @selected_tag %>
  </button>

  <aside id="recipes-filters" class="recipes-sidebar hidden md:block" data-dropdown-target="menu">
    <%= form_with url: recipes_path, method: :get,
                  data: { search_form_target: "form", turbo_frame: "recipe_results", turbo_action: "replace" } do |f| %>
      <%# Searching keeps the selected tag. %>
      <%= hidden_field_tag :tag, @selected_tag.key if @selected_tag %>
      <%= f.search_field :q, value: params[:q], placeholder: "🔍 #{t('.search_placeholder')}",
                             aria: { label: t(".search_placeholder") },
                             data: { action: "input->search-form#submitLater" }, class: "recipes-search" %>
    <% end %>
    <%= render "recipes/tag_catalog", tags_by_kind: @tags_by_kind, tag_counts: @tag_counts,
                                      selected: @selected_tag, query: params[:q] %>
  </aside>
</div>
