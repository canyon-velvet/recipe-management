<%# locals: (recipe:) %>
<%# The whole card links to the recipe (the link lies under the content); only the ⋮ menu takes its own clicks. %>
<div class="recipe-card">
  <%= link_to "", recipe_path(recipe), class: "recipe-card-link", "aria-label": recipe.name %>

  <div class="recipe-card-art">
    <% if (icon = recipe.card_icon) %>
      <span class="recipe-card-icon" aria-hidden="true"><%= icon %></span>
    <% else %>
      <%= image_tag "icons/recipe-placeholder.svg", alt: "", class: "w-16 h-16 object-contain", loading: "lazy" %>
    <% end %>
  </div>

  <div class="recipe-card-body">
    <div class="recipe-card-heading">
      <h3 class="recipe-card-title"><%= recipe.name %></h3>
      <div class="recipe-card-menu">
        <%= render "shared/kebab_menu", items: [
          { label: t("actions.edit"), url: edit_recipe_path(recipe) },
          { label: t("actions.delete"), url: recipe_path(recipe), data: { turbo_method: :delete, turbo_confirm: t("recipes.confirm_delete") }, class: "text-red-600" }
        ] %>
      </div>
    </div>

    <p class="recipe-card-summary"><%= recipe_summary(recipe) %></p>

    <p class="recipe-card-facts">
      <% if recipe.total_minutes %>
        <span><span aria-hidden="true">⏱</span> <%= duration_label(recipe.total_minutes) %></span>
      <% end %>
      <% if recipe.servings %>
        <span><span aria-hidden="true">👥</span><span class="sr-only"><%= t("recipes.facts.servings") %></span> <%= recipe.servings %></span>
      <% end %>
      <span class="recipe-card-tags"><%= recipe.tags.first(2).map(&:name).join(" · ") %></span>
    </p>
  </div>
</div>
