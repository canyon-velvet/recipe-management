<%# locals: (form:, recipe:) %>
<%# Where the recipe is from: chips of the user's sources, Other… to search or create one (shared/source_picker). A
    draft's source the user doesn't have yet is submitted by name and created on save. %>
<%= render "shared/source_picker", field: "#{form.object_name}[source_id]", selected: recipe.source,
                                   new_name: (recipe.new_source_name if recipe.new_source?),
                                   new_name_field: "#{form.object_name}[new_source_name]" %>
