<%# locals: (steps:) %>
<ol class="recipe-steps">
  <% steps.each.with_index(1) do |step, number| %>
    <li>
      <p class="recipe-step-label"><%= t("recipes.show.step", number: number) %></p>
      <div class="prose prose-lg max-w-none text-gray-800"><%= render_markdown(step.body) %></div>
    </li>
  <% end %>
</ol>
