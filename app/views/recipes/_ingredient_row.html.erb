<%# locals: (form:, aisles: []) %>
<% new_ingredient = form.object.new_ingredient? %>
<div data-nested-form-row class="grid grid-cols-12 gap-3 items-start <%= "hidden" if form.object.marked_for_destruction? %>">
  <!-- Ingredient autocomplete -->
  <div class="col-span-5 relative"
       data-controller="autocomplete"
       data-autocomplete-url-value="<%= search_ingredients_path %>"
       data-autocomplete-create-label-value="<%= t("recipes.ingredient_fields.create") %>"
       data-action="autocomplete:requestCreate->inline-create#openModal">
    <%= form.hidden_field :ingredient_id, data: { autocomplete_target: "hiddenField" } %>
    <%# The name goes too: one typed but not picked from the list is the user's ingredient of that name, else created
        on save (as a draft's ingredient the user doesn't have yet is). %>
    <%= tag.input type: "text", name: "#{form.object_name}[new_ingredient_name]",
                  value: form.object.ingredient&.name || form.object.new_ingredient_name,
                  placeholder: t("recipes.ingredient_fields.search"), class: "form-input", autocomplete: "off",
                  data: { autocomplete_target: "input",
                          action: "input->autocomplete#onInput click@window->autocomplete#outside" } %>
    <ul data-autocomplete-target="list" class="autocomplete-list hidden"></ul>

    <% if new_ingredient %>
      <div class="flex items-center gap-2 mt-1">
        <span class="new-badge"><%= t("recipes.form.new_badge") %></span>
        <%= form.select :new_aisle_id, aisles.map { |aisle| [ aisle.name, aisle.id ] }, {},
                        class: "form-select py-1 text-sm", aria: { label: Ingredient.human_attribute_name(:aisle) } %>
      </div>
    <% end %>
  </div>

  <!-- Quantity -->
  <div class="col-span-3">
    <%= form.text_field :quantity, placeholder: t("recipes.ingredient_fields.quantity"), class: "form-input" %>
  </div>

  <!-- Unit -->
  <div class="col-span-3">
    <%= form.text_field :unit, placeholder: t("recipes.ingredient_fields.unit"), class: "form-input" %>
  </div>

  <!-- Remove button -->
  <div class="col-span-1 flex items-center justify-center pt-2">
    <% if form.object.persisted? %>
      <%= form.hidden_field :id %>
      <%= form.hidden_field :_destroy %>
    <% end %>
    <button type="button" data-action="nested-form#remove"
            class="text-gray-400 hover:text-red-500" title="<%= t("actions.delete") %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
</div>
