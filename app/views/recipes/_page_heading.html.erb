<%# locals: (recipe:, description:) %>
<%# The top of the recipe page: emoji, tags, name, quiet Edit / Delete, the description (without its tips), and the
    servings and times. %>
<div class="recipe-heading">
  <div class="recipe-heading-icon" aria-hidden="true">
    <% if (icon = recipe.card_icon) %>
      <%= icon %>
    <% else %>
      <%= image_tag "icons/recipe-placeholder.svg", alt: "", class: "size-16" %>
    <% end %>
  </div>

  <% if recipe.tags.any? %>
    <p class="recipe-heading-tags"><%= recipe.tags.map(&:name).join(" · ") %></p>
  <% end %>
  <h1 class="recipe-heading-title"><%= recipe.name %></h1>

  <p class="recipe-heading-actions">
    <%= link_to edit_recipe_path(recipe), class: "recipe-heading-action" do %>
      <span aria-hidden="true">✎</span> <%= t("actions.edit") %>
    <% end %>
    <span aria-hidden="true">·</span>
    <%= link_to t("actions.delete"), recipe_path(recipe), class: "recipe-heading-action recipe-heading-action--delete",
                data: { turbo_method: :delete, turbo_confirm: t("recipes.confirm_delete") } %>
  </p>

  <% if description %>
    <div class="recipe-description prose prose-lg text-gray-600"><%= render_markdown(description) %></div>
  <% end %>

  <% if (facts = recipe_facts(recipe)).any? %>
    <dl class="recipe-facts">
      <% facts.each do |label, value| %>
        <div class="recipe-fact">
          <dt class="recipe-fact-label"><%= label %></dt>
          <dd class="recipe-fact-value"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</div>
