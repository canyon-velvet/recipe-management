<section class="recipe-form-page">
  <% if @draft %>
    <h1 class="recipe-form-title"><%= t(".review_title") %></h1>
    <p class="recipe-form-hint"><%= t(".review_hint") %></p>
  <% else %>
    <h1 class="recipe-form-title"><%= t(".title") %></h1>
  <% end %>
  <%= render "form", recipe: @recipe,
        aisles: @aisles,
        tags: @tags,
        draft: @draft %>
</section>
