<div data-controller="dropdown" data-action="turbo:before-cache@document->dropdown#hide" class="relative">
  <button type="button" data-action="click->dropdown#toggle click@window->dropdown#close"
          class="account-toggle" aria-haspopup="menu" aria-label="<%= current_user.username %>">
    <%# On a phone, a person icon instead of the name, so the navbar fits %>
    <svg class="w-5 h-5 sm:hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"
         aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round"
            d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z
               M4.5 20.1a7.5 7.5 0 0 1 15 0A17.9 17.9 0 0 1 12 21.75c-2.68 0-5.22-.58-7.5-1.65Z"/>
    </svg>
    <span class="account-name" title="<%= current_user.username %>"><%= current_user.username %></span>
    <%= render "drafts/attention_dot", counts: draft_counts %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div data-dropdown-target="menu" class="account-menu hidden" role="menu">
    <%= link_to drafts_path, class: "account-menu-item", role: "menuitem" do %>
      <%= t(".draft_box") %>
      <%= render "drafts/menu_count", counts: draft_counts %>
    <% end %>
    <%= link_to t(".preferences"), preferences_path, class: "account-menu-item", role: "menuitem" %>
    <button type="button" class="account-menu-item" role="menuitem" data-action="dropdown#hide aisle-editor#open">
      <%= t("aisle_editor.title") %>
    </button>
    <% if current_user.admin? %>
      <%= link_to t(".invites"), invites_path, class: "account-menu-item", role: "menuitem" %>
      <%= link_to t(".background_jobs"), sidekiq_path, data: { turbo: false },
                  class: "account-menu-item", role: "menuitem" %>
    <% end %>
    <%= link_to t(".logout"), logout_path, data: { turbo_method: :delete },
                class: "account-menu-item", role: "menuitem" %>
  </div>
</div>
