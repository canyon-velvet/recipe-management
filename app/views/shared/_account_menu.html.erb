<div data-controller="dropdown" data-action="turbo:before-cache@document->dropdown#hide" class="relative">
  <button type="button" data-action="click->dropdown#toggle click@window->dropdown#close"
          class="account-toggle" aria-haspopup="menu">
    <%# Where the navbar is short of room, a person icon stands in for the name (navbar.css) %>
    <%= image_tag "icons/account.svg", alt: "", class: "account-icon" %>
    <span class="account-name" title="<%= current_user.username %>"><%= current_user.username %></span>
    <%= render "drafts/attention_dot", counts: draft_counts %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <%# Who's signed in (above the menu itself, which holds only its items), the everyday items (importing a recipe
      first, from any page, above the Draft box it lands in), the admin's items as a group named by its label, and
      Log out %>
  <div data-dropdown-target="menu" class="account-menu menu-card hidden">
    <div class="menu-who">
      <span class="menu-avatar" aria-hidden="true"><%= current_user.username.first.upcase %></span>
      <span class="min-w-0">
        <span class="menu-who-name"><%= current_user.username %></span>
        <span class="menu-who-status"><%= t(".signed_in") %></span>
      </span>
    </div>
    <div role="menu">
      <%= link_to new_import_path, class: "menu-item", role: "menuitem" do %>
        <%= inline_icon "import" %> <%= t(".import_recipe") %>
      <% end %>
      <%= link_to drafts_path, class: "menu-item", role: "menuitem" do %>
        <%= inline_icon "drafts" %>
        <span class="flex-1"><%= t(".draft_box") %></span>
        <%= render "drafts/menu_count", counts: draft_counts %>
      <% end %>
      <%= link_to preferences_path, class: "menu-item", role: "menuitem" do %>
        <%= inline_icon "preferences" %> <%= t(".preferences") %>
      <% end %>
      <button type="button" class="menu-item" role="menuitem" data-action="dropdown#hide aisle-editor#open">
        <%= inline_icon "aisles" %> <%= t("aisle_editor.title") %>
      </button>
      <% if current_user.admin? %>
        <div role="group" aria-labelledby="account_menu_admin">
          <p id="account_menu_admin" class="menu-label" role="none"><%= t(".admin") %></p>
          <%= link_to invites_path, class: "menu-item", role: "menuitem" do %>
            <%= inline_icon "invites" %> <%= t(".invites") %>
          <% end %>
          <%= link_to jobs_dashboard_path, class: "menu-item", role: "menuitem", data: { turbo: false } do %>
            <%= inline_icon "jobs" %> <%= t(".background_jobs") %>
          <% end %>
        </div>
      <% end %>
      <div class="menu-divider" role="separator"></div>
      <%= link_to logout_path, class: "menu-item menu-item--logout", role: "menuitem",
                               data: { turbo_method: :delete } do %>
        <%= inline_icon "logout" %> <%= t(".logout") %>
      <% end %>
    </div>
  </div>
</div>
