<%# locals: (form:, field:, label:, rows: 6, min_height: "156px", help: nil, class: nil) %>
<div class="field <%= binding.local_variable_get(:class) %>" data-controller="markdown-preview"
     data-markdown-preview-empty-text-value="<%= t(".empty_preview") %>"
     data-markdown-preview-failed-text-value="<%= t(".preview_failed") %>"
     data-markdown-preview-url-value="<%= markdown_preview_path %>">
  <%= form.label field, label, class: "form-label" %>
  <div class="md-tab-bar">
    <button type="button" class="md-tab tab-active" data-markdown-preview-target="writeTab" data-action="markdown-preview#showWrite"><%= t(".write") %></button>
    <button type="button" class="md-tab" data-markdown-preview-target="previewTab" data-action="markdown-preview#showPreview"><%= t(".preview") %></button>
  </div>
  <%= form.text_area field, rows: rows, class: "form-textarea rounded-t-none",
        data: { markdown_preview_target: "input" } %>
  <div data-markdown-preview-target="preview"
       class="hidden prose prose-sm max-w-none rounded-lg rounded-t-none border border-gray-300 bg-white p-3 overflow-auto"
       style="min-height: <%= min_height %>;"></div>
  <% if help.present? %>
    <p class="help-text"><%= help %></p>
  <% end %>
</div>
