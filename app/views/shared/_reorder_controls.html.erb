<%# locals: (label:) %>
<%# A reorder-list row's parts in reorder mode: its one-line preview, which drags with a mouse (on a touch screen it
    scrolls the page), and a handle that drags and also moves the row with ↑ ↓. %>
<p class="reorder-preview" data-reorder-list-target="preview" data-action="pointerdown->sortable#drag"
   data-sortable-mouse-only-param="true"></p>
<button type="button" class="reorder-handle" aria-label="<%= label %>"
        data-reorder-list-target="handle" data-action="pointerdown->sortable#drag keydown->sortable#moveWithKeys">
  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-width="2" d="M4 8h16M4 12h16M4 16h16"/>
  </svg>
</button>
