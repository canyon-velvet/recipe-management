<%# locals: (frame:, labelledby:, src: nil) %>
<%# A roomy pop-up holding another page's form (new meal plan, import), which loads the first time it opens. Needs a
    modal controller on an ancestor. The form submits to the whole page, which goes on, or shows the form again on a
    page of its own with its problem. Once closed, the form is loaded again, so the next open starts afresh. Closed
    before Turbo caches the page, so Back doesn't bring it back open. Without src, a link elsewhere on the page loads
    it (data-turbo-frame), e.g. a recipe's Share, and it opens once loaded. %>
<dialog data-modal-target="dialog" class="modal-dialog--roomy" aria-labelledby="<%= labelledby %>"
        data-action="click->modal#backdropClose close->modal#closed turbo:before-cache@document->modal#close">
  <div class="modal-panel modal-panel--roomy">
    <button type="button" class="modal-close" data-action="modal#close" aria-label="<%= t("actions.close") %>">×</button>
    <% if src %>
      <%= turbo_frame_tag frame, src: src, loading: :lazy, data: { modal_target: "frame" } do %>
        <p class="help-text"><%= t(".loading") %></p>
      <% end %>
    <% else %>
      <%= turbo_frame_tag frame, data: { action: "turbo:frame-load->modal#open" } %>
    <% end %>
  </div>
</dialog>
