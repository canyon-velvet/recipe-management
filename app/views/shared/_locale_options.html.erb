<%# A button per language; the current one is marked (brown, with a ✓). In the 🌐 menu, and in ☰ when the navbar is
    folded. %>
<% I18n.available_locales.each do |locale| %>
  <% current = locale == I18n.locale %>
  <%= button_to locale_path, method: :patch, params: { locale: locale }, lang: locale, aria: { current: current },
                class: "menu-item #{'menu-item--current' if current}", form: { data: { turbo: false } } do %>
    <span class="flex-1"><%= t("locale_name", locale: locale) %></span>
    <%= inline_icon "check" if current %>
  <% end %>
<% end %>
