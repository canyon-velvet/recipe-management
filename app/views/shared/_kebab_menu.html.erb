<%# locals: (items:) %>
<%# Closed before Turbo caches the page, so going Back to it doesn't show the menu still open. %>
<div data-controller="dropdown" data-action="turbo:before-cache@document->dropdown#hide" class="relative">
  <button type="button" data-dropdown-target="button" data-action="click->dropdown#toggle click@window->dropdown#close"
          aria-label="<%= t("actions.more") %>" aria-haspopup="true" aria-expanded="false"
          class="p-1 rounded hover:bg-gray-100">
    <svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
      <circle cx="10" cy="4" r="1.5"/>
      <circle cx="10" cy="10" r="1.5"/>
      <circle cx="10" cy="16" r="1.5"/>
    </svg>
  </button>

  <div data-dropdown-target="menu"
       class="hidden absolute right-0 mt-1 w-32 bg-white border border-gray-200 rounded-lg shadow-lg z-30">
    <% items.each do |item| %>
      <%= link_to item[:label], item[:url],
            data: item[:data] || {},
            class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 #{item[:class]}" %>
    <% end %>
  </div>
</div>
