<%# ☰: the navbar's links and the language switcher, folded into one list when there isn't room for them (a narrow
    window, or beside the open assistant panel; navbar.css decides). Closed before Turbo caches the page. %>
<div class="navbar-menu" data-controller="dropdown" data-action="turbo:before-cache@document->dropdown#hide">
  <button type="button" class="navbar-menu-toggle" data-action="click->dropdown#toggle click@window->dropdown#close"
          aria-label="<%= t(".label") %>">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  </button>

  <%# The links with their icons (the page you're on in brown), then the languages under a label %>
  <div data-dropdown-target="menu" class="navbar-menu-list menu-card hidden">
    <% navbar_links.each do |label, path, icon| %>
      <% current = current_page?(path) %>
      <%= link_to path, class: "menu-item #{'menu-item--current' if current}", aria: { current: ("page" if current) } do %>
        <%= inline_icon icon %> <%= label %>
      <% end %>
    <% end %>
    <p class="menu-label"><%= t("shared.locale_switcher.label") %></p>
    <%= render "shared/locale_options" %>
  </div>
</div>
