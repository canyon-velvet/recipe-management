<%# ☰: the navbar's links and the language switcher, folded into one menu when there isn't room for them (a narrow
    window, or beside the open assistant panel; navbar.css decides). Closed before Turbo caches the page. %>
<div class="navbar-menu" data-controller="dropdown" data-action="turbo:before-cache@document->dropdown#hide">
  <button type="button" class="navbar-menu-toggle" data-action="click->dropdown#toggle click@window->dropdown#close"
          aria-label="<%= t(".label") %>" aria-haspopup="menu">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  </button>

  <div data-dropdown-target="menu" class="navbar-menu-list hidden" role="menu">
    <% links = [ [ t("shared.navbar.home"), root_path ] ]
       links += [ [ t("shared.navbar.recipes"), recipes_path ], [ t("shared.navbar.meal_plans"), meal_plans_path ] ] if logged_in? %>
    <% links.each do |label, path| %>
      <%= link_to label, path, role: "menuitem",
                  class: "navbar-menu-item #{'navbar-menu-item--active' if current_page?(path)}" %>
    <% end %>
    <p class="navbar-menu-heading"><%= t("shared.locale_switcher.label") %></p>
    <%= render "shared/locale_options" %>
  </div>
</div>
