<section class="preferences-page">
  <h1 class="preferences-title"><%= t(".title") %></h1>
  <p class="preferences-subtitle"><%= t(".subtitle") %></p>

  <%# One sheet, a row per category, each row its own Turbo Frame %>
  <div class="preferences-sheet">
    <% Preference::CATEGORIES.each do |category| %>
      <%= render "preferences/card", category: category, preferences: @preferences.fetch(category, []) %>
    <% end %>
  </div>
  <p class="preferences-hint"><%= t(".add_hint") %></p>
</section>
