<section class="preferences-page">
  <p class="home-eyebrow"><%= t(".eyebrow") %></p>
  <h1 class="preferences-title"><%= t(".title") %></h1>
  <p class="preferences-subtitle"><%= t(".subtitle") %></p>

  <%# One sheet, a row per category, each row its own Turbo Frame; who you cook for comes first %>
  <div class="preferences-sheet">
    <% Preference::CATEGORIES.partition { |category| category == "household" }.flatten.each do |category| %>
      <%= render "preferences/card", category: category, preferences: @preferences.fetch(category, []) %>
    <% end %>
  </div>
  <p class="preferences-hint"><%= t(".add_hint") %></p>

  <div class="preferences-sheet">
    <%= render "preferences/time_zone", user: current_user %>
  </div>
</section>
