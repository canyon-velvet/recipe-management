<section class="page">
  <p class="home-eyebrow"><%= t(".eyebrow") %></p>
  <h1 class="page-title"><%= t(".title") %></h1>
  <p class="page-subtitle"><%= t(".subtitle", days: Invite::LIFETIME.in_days.to_i) %></p>

  <%= form_with model: @invite, class: "invite-form" do |f| %>
    <%= f.text_field :note, class: "invite-note", maxlength: 100, autocomplete: "off",
                            placeholder: t(".note_placeholder"), "aria-label": Invite.human_attribute_name(:note) %>
    <%= f.submit "＋ #{t('.create')}", class: "btn-pill-primary btn-pill-sm cursor-pointer" %>
  <% end %>
  <% @invite.errors.full_messages.each do |message| %>
    <p class="error-text mt-2"><%= message %></p>
  <% end %>

  <% if @invites.any? %>
    <ol class="invites-list">
      <%= render partial: "invites/invite", collection: @invites %>
    </ol>
  <% else %>
    <p class="page-empty"><%= t(".empty") %></p>
  <% end %>
</section>
