<%# locals: (invite:) %>
<%# An invite and what became of it: a tile for its state (a link while it can be used, ✓ once used, a clock once
    expired), who it's for and its state, and when it expires or who used it. Until it's used or expires, its link can
    be copied to send; until it's used, it can be deleted, which stops the link working. %>
<% state = invite.state %>
<li id="<%= dom_id(invite) %>" class="invite-row">
  <div class="invite-main">
    <span class="invite-icon invite-icon--<%= state %>" aria-hidden="true">
      <% case state %>
      <% when "active" %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
      <% when "used" %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
      <% else %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <% end %>
    </span>

    <div class="invite-body">
      <div class="invite-heading">
        <h2 class="invite-title"><%= invite.note.presence || t(".untitled") %></h2>
        <span class="invite-status invite-status--<%= state %>"><%= t(".statuses.#{state}") %></span>
      </div>
      <p class="invite-meta">
        <% case state %>
        <% when "used" %>
          <%= t(".used", username: invite.used_by&.username || t(".deleted_account"),
                        time: time_ago_in_words(invite.used_at)) %>
        <% when "active" %>
          <%= t(".expires", time: distance_of_time_in_words(Time.current, invite.expires_at)) %>
        <% else %>
          <%= t(".expired_ago", time: time_ago_in_words(invite.expires_at)) %>
        <% end %>
      </p>
    </div>

    <% unless invite.used? %>
      <%= button_to t("actions.delete"), invite_path(invite), method: :delete, class: "btn-pill-ghost btn-pill-sm",
                    form: { class: "flex-none", data: { turbo_confirm: t(".confirm_delete") } } %>
    <% end %>
  </div>

  <% if state == "active" %>
    <div class="invite-link" data-controller="clipboard" data-clipboard-copied-text-value="<%= t(".copied") %>">
      <input type="text" readonly value="<%= register_url(invite_token: invite.token) %>" class="invite-link-field"
             data-clipboard-target="source" aria-label="<%= t(".link") %>">
      <button type="button" class="btn-pill-secondary btn-pill-sm flex-none cursor-pointer" data-clipboard-target="button"
              data-action="clipboard#copy"><%= t(".copy") %></button>
    </div>
  <% end %>
</li>
