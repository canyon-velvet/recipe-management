<%# locals: (conversation:, open:) %>
<%# The assistant side panel. Turbo keeps it (data-turbo-permanent) as the user moves between pages, so the chat and
    what's being typed survive navigation. Turbo matches it by id, so the id is per user: after logging in as someone
    else, the old panel is replaced. The assistant-panel controller on <body> opens and closes it. %>
<aside id="<%= assistant_panel_id %>" class="assistant-panel <%= 'hidden' unless open %>" data-turbo-permanent
       data-assistant-panel-target="panel" aria-label="<%= t("assistant.title") %>">
  <div class="assistant-header">
    <span class="assistant-mark" aria-hidden="true">✦</span>
    <h2 class="assistant-title"><%= t("assistant.title") %></h2>
    <%= button_to assistant_conversations_path, class: "btn-pill-secondary assistant-new-chat",
                  form: { data: { turbo_stream: true } } do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      <%= t("assistant.new_chat") %>
    <% end %>
    <button type="button" class="assistant-close" data-action="assistant-panel#close"
            aria-label="<%= t("assistant.close") %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <%# Replies stream in over the user's own signed stream (WriteReplyService broadcasts to it). %>
  <%= turbo_stream_from current_user, :assistant %>
  <%= render "assistant/conversations/messages", conversation: conversation %>
  <%= render "assistant/messages/limit_strip", user: current_user %>
  <%= render "assistant/messages/form" %>
</aside>
