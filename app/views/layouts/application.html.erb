<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# The Edit-aisles pop-up can be opened from any page (account menu, grocery list), and so can the assistant. %>
  <%= tag.body class: [ "bg-gray-50 min-h-screen", ("assistant-open" if assistant_open?) ],
               data: { controller: body_controllers } do %>
    <%= render "shared/navbar" %>

    <main class="container mx-auto px-5 py-6">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/confirm_dialog" %>

    <% if logged_in? %>
      <%= render "aisles/editor_dialog" %>
      <%# Live Draft box updates (cards, menu count, "ready" toasts) on this user's own signed stream. %>
      <%= turbo_stream_from current_user, :drafts %>
      <div id="toasts" class="toast-stack" aria-live="polite"></div>
    <% end %>

    <% if assistant_available? %>
      <%= render "assistant/panel", conversation: current_user.current_conversation, open: assistant_open? %>
    <% end %>
  <% end %>
</html>
