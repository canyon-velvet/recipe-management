<dialog data-recipe-select-target="dialog" aria-labelledby="recipe_search_title"
        data-action="click->recipe-select#backdropClose"
        class="rounded-xl p-0 backdrop:bg-black/40">
  <div class="modal-panel" style="min-width: 320px;">
    <h3 id="recipe_search_title" class="modal-title"><%= t(".title") %></h3>

    <input type="text"
           class="form-input mb-3"
           placeholder="<%= t(".search_placeholder") %>"
           autocomplete="off"
           data-recipe-select-target="input"
           data-action="input->recipe-select#onInput">

    <input type="hidden" data-recipe-select-target="slotId">

    <ul data-recipe-select-target="results" class="max-h-64 overflow-auto space-y-1">
      <li class="text-sm text-gray-400 text-center py-4"><%= t(".prompt") %></li>
    </ul>

    <div class="flex justify-end pt-3">
      <button type="button" data-action="recipe-select#close" class="btn-cancel"><%= t("actions.cancel") %></button>
    </div>
  </div>
</dialog>
