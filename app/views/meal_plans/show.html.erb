<%# A week's plan: the heading, then the week (a grid on a wide screen, a card per day on a phone), with the pop-up that
    adds a recipe to a meal. %>
<section class="meal-plan-page" data-controller="recipe-select"
         data-recipe-select-search-url-value="<%= search_recipes_path %>"
         data-recipe-select-prompt-text-value="<%= t("meal_plans.recipe_search_modal.prompt") %>"
         data-recipe-select-no-results-text-value="<%= t(".no_recipes_found") %>">
  <div id="meal_plan_header"><%= render "meal_plans/header", meal_plan: @meal_plan %></div>
  <%= render "meal_plans/week", meal_plan: @meal_plan, grid: @grid %>
  <%= render "meal_plans/recipe_search_modal" %>
</section>
