<%# locals: (meal_plan:) %>
<%# The whole row links to the week (the link lies under the content); the grocery list and ⋮ take their own clicks. %>
<% planned = meal_plan.planned_meal_count %>
<div class="list-row meal-plan-row <%= 'meal-plan-row--current' if meal_plan.this_week? %>">
  <%= link_to "", meal_plan_path(meal_plan), class: "meal-plan-row-link", "aria-label": meal_plan_title(meal_plan) %>

  <div class="meal-plan-date">
    <span class="meal-plan-date-month"><%= l(meal_plan.start_date, format: "%b") %></span>
    <span class="meal-plan-date-day"><%= meal_plan.start_date.day %></span>
  </div>

  <div class="meal-plan-body">
    <div class="meal-plan-heading">
      <h3 class="meal-plan-name"><%= meal_plan_title(meal_plan) %></h3>
      <% if meal_plan.this_week? %>
        <span class="status-pill meal-plan-badge meal-plan-badge--current"><%= t(".this_week") %></span>
      <% elsif meal_plan.next_week? %>
        <span class="status-pill meal-plan-badge"><%= t(".next_week") %></span>
      <% end %>
    </div>
    <p class="meal-plan-facts">
      <%= week_dates(meal_plan.start_date) %> ·
      <span class="whitespace-nowrap"><%= t(".recipe_count", count: meal_plan.assigned_recipe_count) %></span>
    </p>
    <div class="meal-plan-meter">
      <progress class="meal-plan-meter-bar" max="<%= MealPlan::MEALS_PER_WEEK %>" value="<%= planned %>"
                aria-hidden="true"></progress>
      <span class="meal-plan-meter-label"><%= t(".planned_meals", planned: planned, total: MealPlan::MEALS_PER_WEEK) %></span>
    </div>
  </div>

  <div class="meal-plan-actions">
    <%= link_to t("meal_plans.show.grocery_list"), meal_plan_grocery_list_path(meal_plan),
          class: "btn-pill-secondary btn-pill-sm" %>
    <%= render "shared/kebab_menu", items: [
      { label: t("actions.delete"), url: meal_plan_path(meal_plan), data: { turbo_method: :delete, turbo_confirm: t(".confirm_delete") }, class: "text-red-600" }
    ] %>
  </div>
</div>
