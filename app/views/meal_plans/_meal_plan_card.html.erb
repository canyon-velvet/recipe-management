<%# locals: (meal_plan:) %>
<div class="section-card relative hover:shadow-md transition-shadow">
  <%= link_to "", meal_plan_path(meal_plan), class: "absolute inset-0 block z-0", "aria-label": meal_plan.display_name %>

  <div class="relative z-10 flex items-start justify-between pointer-events-none">
    <div>
      <h3 class="font-semibold text-gray-900"><%= meal_plan.display_name %></h3>
      <p class="text-sm text-gray-500 mt-1"><%= format_week_range(meal_plan) %></p>
      <p class="text-xs text-gray-400 mt-2"><%= t(".recipe_count", count: meal_plan.assigned_recipe_count) %></p>
    </div>

    <div class="flex-none pointer-events-auto relative z-20">
      <%= render "shared/kebab_menu", items: [
        { label: t("meal_plans.show.grocery_list"), url: meal_plan_grocery_list_path(meal_plan) },
        { label: t("actions.delete"), url: meal_plan_path(meal_plan), data: { turbo_method: :delete, turbo_confirm: t(".confirm_delete") }, class: "text-red-600" }
      ] %>
    </div>
  </div>
</div>
