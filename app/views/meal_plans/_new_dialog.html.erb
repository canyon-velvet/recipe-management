<%# Needs a modal controller on an ancestor. The form (meal_plans/new) loads the first time the pop-up opens; it
    submits to the whole page, which goes to the new plan, or shows the form again with its problem. %>
<dialog data-modal-target="dialog" data-action="click->modal#backdropClose close->modal#close"
        class="w-full max-w-md rounded-xl p-0 backdrop:bg-black/40" aria-labelledby="new_meal_plan_title">
  <div class="modal-panel">
    <%= turbo_frame_tag "new_meal_plan", src: new_meal_plan_path, loading: :lazy do %>
      <p class="help-text"><%= t(".loading") %></p>
    <% end %>
  </div>
</dialog>
