<%# locals: (meal_slot:) %>
<%# One meal's recipes as pills (the grocery tick, the emoji, the name linking to the recipe, × to remove), and ＋ Add.
    Redrawn by meal_slot_recipes after adding, removing or ticking. %>
<div class="meal-slot-recipes">
  <% meal_slot.meal_slot_recipes.each do |msr| %>
    <div class="meal-pill <%= 'meal-pill--on-list' if msr.add_to_grocery_list %>">
      <input type="checkbox" class="meal-pill-check" <%= "checked" if msr.add_to_grocery_list %>
             title="<%= t(".on_grocery_list", recipe: msr.recipe.name) %>"
             aria-label="<%= t(".on_grocery_list", recipe: msr.recipe.name) %>"
             data-action="change->recipe-select#toggleGrocery" data-url="<%= meal_slot_recipe_path(msr) %>">
      <span aria-hidden="true"><%= msr.recipe.card_icon || "🍽️" %></span>
      <%= link_to msr.recipe.name, recipe_path(msr.recipe), class: "meal-pill-name", data: { turbo_frame: "_top" } %>
      <%= button_to "×", meal_slot_recipe_path(msr), method: :delete, class: "meal-pill-remove",
                    title: t(".remove", recipe: msr.recipe.name), aria: { label: t(".remove", recipe: msr.recipe.name) },
                    form: { class: "contents", data: { turbo_stream: true } } %>
    </div>
  <% end %>
  <button type="button" class="meal-slot-add" data-action="recipe-select#openForSlot"
          data-meal-slot-id="<%= meal_slot.id %>">＋ <%= t(".add") %></button>
</div>
