<%# Not cached: Back after creating a plan shows it in the list, and the pop-up's weeks without it %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<section class="meal-plans-page" data-controller="modal">
  <div class="meal-plans-header">
    <div>
      <p class="home-eyebrow"><%= t(".eyebrow") %></p>
      <h1 class="meal-plans-title"><%= t(".title") %></h1>
    </div>
    <%= link_to "＋ #{t('.new_meal_plan')}", new_meal_plan_path, class: "btn-pill-primary btn-pill-sm",
          data: { action: "modal#open:prevent" } %>
  </div>
  <%= render "shared/modal_frame", frame: "new_meal_plan", src: new_meal_plan_path, labelledby: "new_meal_plan_title" %>

  <% if @meal_plans.any? %>
    <%# Grouped by the month each week starts in, newest first %>
    <% @meal_plans.group_by { |meal_plan| meal_plan.start_date.beginning_of_month }.each do |month, meal_plans| %>
      <section class="meal-plans-month">
        <h2 class="recipe-section-heading"><%= l(month, format: :month_year) %></h2>
        <ol class="meal-plans-list">
          <% meal_plans.each do |meal_plan| %>
            <li><%= render "meal_plan_card", meal_plan: meal_plan %></li>
          <% end %>
        </ol>
      </section>
    <% end %>

    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <p class="meal-plans-empty"><%= t(".empty") %></p>
  <% end %>
</section>
