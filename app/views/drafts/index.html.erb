<section class="page" data-controller="modal">
  <div class="page-header">
    <div>
      <p class="home-eyebrow"><%= t(".eyebrow") %></p>
      <h1 class="page-title"><%= t(".title") %></h1>
      <p class="page-subtitle"><%= t(".subtitle") %></p>
    </div>
    <%= link_to "＋ #{t('recipes.index.import_recipe')}", new_import_path, class: "btn-pill-primary btn-pill-sm",
          data: { action: "modal#open:prevent" } %>
  </div>
  <%= render "shared/modal_frame", frame: "new_import", src: new_import_path, labelledby: "new_import_title" %>

  <% if @drafts.any? %>
    <ol class="drafts-list">
      <% @drafts.each do |draft| %>
        <%= render "drafts/draft", draft: draft %>
      <% end %>
    </ol>
  <% else %>
    <p class="page-empty"><%= t(".empty") %></p>
  <% end %>
</section>
