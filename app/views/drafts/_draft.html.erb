<%# locals: (draft:) %>
<%# A draft's row: a tile for where it's at (a spinner while it's read, ✓ when ready, ! when it failed), its title
    and status, where it's from and when, the reason when it failed, then what can be done with it. Replaced live as
    the import goes on (DraftBoxBroadcasts). %>
<li id="<%= dom_id(draft) %>" class="list-row draft-row">
  <span class="status-tile draft-icon draft-icon--<%= draft.status %>" aria-hidden="true">
    <%= { "ready" => "✓", "failed" => "!" }[draft.status] %>
  </span>

  <div class="status-body">
    <div class="status-heading">
      <h2 class="status-title"><%= draft.title %></h2>
      <span class="status-pill draft-status--<%= draft.status %>"><%= t("drafts.statuses.#{draft.status}") %></span>
    </div>
    <p class="draft-meta">
      <%= draft_source(draft) %> · <%= t(".added", time: time_ago_in_words(draft.created_at)) %>
    </p>
    <% if draft.failed? %>
      <p class="draft-failure"><%= t("drafts.failures.#{draft.failure_reason_key}", default: t("drafts.failures.generic")) %></p>
    <% end %>
  </div>

  <div class="draft-actions">
    <% if draft.ready? %>
      <%= link_to t(".review"), new_recipe_path(draft_id: draft.id), class: "btn-pill-primary btn-pill-sm" %>
    <% elsif draft.failed? %>
      <%= button_to retry_draft_path(draft), class: "btn-pill-secondary btn-pill-sm draft-retry" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.3L4 15M4 20v-5h5"/></svg>
        <%= t(".retry") %>
      <% end %>
      <% if draft.source_url %>
        <%= link_to t(".paste_instead"), new_import_path(url: draft.source_url, paste: 1), class: "btn-pill-secondary btn-pill-sm" %>
      <% end %>
    <% end %>
    <%= button_to t(".discard"), draft_path(draft), method: :delete, class: "btn-pill-ghost btn-pill-sm",
                  form: { data: { turbo_confirm: t(".confirm_discard", title: draft.title) } } %>
  </div>
</li>
